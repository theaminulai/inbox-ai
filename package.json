{
    "name": "cf7-ai-inbox",
    "version": "1.0.0",
    "description": "CF7 AI Inbox for Contact Form 7",
    "author": "theaminulai",
    "license": "GPL-3.0-or-later",
    "private": true,
    "scripts": {
        "build": "wp-scripts build",
        "start": "wp-scripts start",
        "format": "wp-scripts format ./src",
        "lint": "npm run lint:js && npm run lint:css",
        "lint:js": "wp-scripts lint-js",
        "lint:css": "wp-scripts lint-style",
        "lint:fix": "wp-scripts lint-js --fix && wp-scripts lint-style --fix",
        "lint:pkg-json": "wp-scripts lint-pkg-json",
        "packages-update": "wp-scripts packages-update",
        "plugin-zip": "wp-scripts plugin-zip",
        "update-version": "node update-version-and-changelog.js",
        "make-pot": "php vendor/wp-cli/wp-cli/php/boot-fs.php i18n make-pot . languages/cf7-ai-inbox.pot --domain=cf7-ai-inbox --exclude=node_modules,vendor,tests"
    },
    "devDependencies": {
        "@wordpress/scripts": "^30.23.0",
        "@actions/core": "^1.10.0",
        "npm-check-updates": "^16.14.20",
        "simple-git": "^3.27.0",
        "webpack-remove-empty-scripts": "^1.1.1"
    }
}