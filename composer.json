{
    "name": "theaminulai/cf7-ai-inbox",
    "description": "CF7 AI Inbox for Contact Form 7",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "carthage-software/mago": "^1.24.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "overtrue/phplint": "^9.0",
        "php-stubs/woocommerce-stubs": "^8.0",
        "php-stubs/wordpress-stubs": "^6.9",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.9",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "wp-coding-standards/wpcs": "^3.3.0",
        "wp-cli/i18n-command": "^2.6",
        "wp-cli/wp-cli": "^2.11"
    },
    "autoload": {
        "psr-4": {
            "CF7AIInbox\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CF7AIInbox\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint":    "vendor/bin/phplint --no-cache .",
        "cs":      "vendor/bin/phpcs",
        "cs-fix":  "vendor/bin/phpcbf",
        "analyze": "vendor/bin/phpstan analyse --memory-limit=1G",
        "test":    "vendor/bin/phpunit --testdox",
        "format":  "vendor/bin/mago format"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "automattic/jetpack-autoloader": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "extra": {
        "wordpress-install-dir": "wp"
    }
}